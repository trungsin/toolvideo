# Genius API Token for lyrics fetch
# Get your token at: https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_token_here

# API key for external clients (MCP, scripts).
# When set, /api/* requires X-API-Key header unless Origin/Referer matches the web UI host.
# Generate with: openssl rand -hex 32
API_KEY=

# YouTube cookies, needed when YouTube says "Sign in to confirm you're not a bot" / HTTP 429.
# Netscape cookies.txt exported from a logged-in browser (wins if both are set):
YTDLP_COOKIES=
# Or read straight from a local browser profile, e.g. chrome, firefox, safari, firefox:PROFILE
YTDLP_COOKIES_FROM_BROWSER=
